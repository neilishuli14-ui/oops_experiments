#include <iostream>
using namespace std;

class A {
    int x; 
public:
    A() {
        x = 0;
    }

    A(int a) {
        x = a;
    }

    A(const A &obj) {
        x = obj.x;
    }

    A(A &&obj) {
        x = obj.x;
        obj.x = 0;
    }

    void print() {
        cout << x << endl;
    }
};

int main() {
    A obj1; 
    obj1.print();

    A obj2(2); 
    obj2.print();

    A obj3(obj2); 
    obj3.print();

    A obj4(std::move(obj1));
    obj4.print();

    return 0;
}
