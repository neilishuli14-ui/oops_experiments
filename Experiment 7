#include <iostream>
using namespace std;

class Matrix {
    int a, b;

public:
    void set(int x, int y) {
        a = x;
        b = y;
    }

    void display() const {
        cout << a << " " << b << endl;
    }

    void add(int x, int y) const {
        cout << "Sum = " << x + y << endl;
    }

    void add(const Matrix& m) const {
        cout << "Sum = " << a + m.a << " " << b + m.b << endl;
    }

    Matrix operator+(const Matrix& m) const {
        Matrix temp;
        temp.a = a + m.a;
        temp.b = b + m.b;
        return temp;
    }
};

int main() {
    Matrix m1, m2, m3;
    m1.set(1, 2);
    m2.set(3, 4);

    cout << "First Matrix: ";
    m1.display();

    cout << "Second Matrix: ";
    m2.display();

    m1.add(5, 6);
    m1.add(m2);

    m3 = m1 + m2;
    cout << "Using operator overloading: ";
    m3.display();

    return 0;
}
