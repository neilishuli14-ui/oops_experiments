#include <iostream>
#include <string>
using namespace std;
int main ()
{
  int const x = 2;
  float y = 4.999;
  cout << "Hello World" << endl;
  cout << "Value of int (constant): " << x << endl;
  cout << "Value of float: " << y << endl;
  y = 5.111;
  cout << "Value of float (changed): " << y << endl;
  int a, b;
  cout << "Enter a: ";
  cin >> a;
  cout << "Enter b: ";
  cin >> b;
  int sum = a + b;
  int subtraction = a - b;
  cout << "a + b = " << sum << endl;
  cout << "a - b = " << subtraction << endl;
  cout << "Thank you so much for using this program!" << endl;
  return 0;
}
